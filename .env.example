# Petbnb environment variables.
# Copy to `.env` (gitignored) and fill in real values. In production these
# are set as Vercel project environment variables, NOT committed.
#
# Every value is read in app.config.ts and bridged to the running app via
# Constants.expoConfig.extra. Each consumer no-ops cleanly when its value
# is absent, so the app builds and runs with none of these set.

# --- Supabase (required for any real backend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Phase 1 observability (optional; leave blank to disable) ---
# Sentry error tracking (web). Project → Settings → Client Keys (DSN).
SENTRY_DSN=
# PostHog product analytics (web). Project → Settings → Project API Key.
POSTHOG_KEY=
# PostHog API host. US cloud: https://us.i.posthog.com  EU: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
