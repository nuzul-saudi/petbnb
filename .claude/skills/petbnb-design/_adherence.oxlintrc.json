{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/listings/**",
              "components/navigation/**",
              "ui_kits/petbnb_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Tajawal|Reem Kufi))/i]",
        "message": "Font not provided by the design system. Available: Tajawal, Reem Kufi."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|locale|onLanguageToggle|personaToggleLabel|onPersonaToggle|pendingCount|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: items, locale, onLanguageToggle, personaToggleLabel, onPersonaToggle, pendingCount."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<AppHeader> locale must be one of 'ar' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:photoUrl|name|glyph|size|rounded|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: photoUrl, name, glyph, size, rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|color|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: label, tone, color, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|silver|bronze|new|accent|danger|neutral)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'silver' | 'bronze' | 'new' | 'accent' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onPress|variant|size|disabled|loading|fullWidth|icon|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: label, onPress, variant, size, disabled, loading, fullWidth, icon, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:normal|compact)$/]",
        "message": "<Button> size must be one of 'normal' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pad|interactive|sunken|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, pad, interactive, sunken, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|onPress|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: label, active, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|helper|error|type|disabled|id|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, helper, error, type, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:hostName|hostPhoto|verified|tier|gender|district|city|distanceKm|title|price|maxPets|coverPhoto|isNew|statusBadge|onPress|key|ref|className|style|children)$/]",
        "message": "<ListingCard> doesn't accept that prop. Declared props: hostName, hostPhoto, verified, tier, gender, district, city, distanceKm, title, price, maxPets, coverPhoto, isNew, statusBadge, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListingCard'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:gold|silver|bronze)$/]",
        "message": "<ListingCard> tier must be one of 'gold' | 'silver' | 'bronze'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListingCard'] > JSXAttribute[name.name='gender'] > Literal[value!=/^(?:female|male)$/]",
        "message": "<ListingCard> gender must be one of 'female' | 'male'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|title|desc|icon|selected|onPress|key|ref|className|style|children)$/]",
        "message": "<RoleCard> doesn't accept that prop. Declared props: role, title, desc, icon, selected, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleCard'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:owner|host|both)$/]",
        "message": "<RoleCard> role must be one of 'owner' | 'host' | 'both'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
